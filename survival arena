-- by Grok - Tháng 3/2026

local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

_G.Enabled = true
_G.AuraRange = 35   -- Tăng số này nếu muốn kill xa hơn (30-50 là ổn)

print("✅ Script đã load! God Mode + Invis + Kill Aura đang bật...")

-- God Mode (không mất máu)
spawn(function()
    while _G.Enabled do
        pcall(function()
            if character and character:FindFirstChild("Humanoid") then
                local hum = character.Humanoid
                hum.MaxHealth = 1e9
                hum.Health = 1e9
            end
        end)
        wait(0.03)
    end
end)

-- Invisible (zombie khó cắn và khó nhìn thấy bạn)
spawn(function()
    while _G.Enabled do
        pcall(function()
            if character then
                for _, part in pairs(character:GetDescendants()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        part.Transparency = 1
                    end
                end
            end
        end)
        wait(0.4)
    end
end)

-- Kill Aura (cầm súng sẽ tự động giết zombie gần bạn)
spawn(function()
    while _G.Enabled do
        pcall(function()
            if character and character:FindFirstChild("HumanoidRootPart") then
                local root = character.HumanoidRootPart
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:FindFirstChild("Humanoid") and obj.Humanoid.Health > 0 and obj ~= character then
                        local dist = (obj.HumanoidRootPart.Position - root.Position).Magnitude
                        if dist <= _G.AuraRange then
                            obj.Humanoid:TakeDamage(9999)  -- giết mạnh
                        end
                    end
                end
            end
        end)
        wait(0.08)  -- tốc độ kill aura (nhanh nhưng không lag quá)
    end
end)

-- Tự chạy lại khi chết và respawn
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    wait(1)
    print("🔄 Nhân vật mới - Script tự chạy lại!")
end)

print("🎮 God Mode + Invisible + Kill Aura (Hold Gun) đã kích hoạt!")
print("   Cầm súng ra và thử gần zombie xem sao!")
